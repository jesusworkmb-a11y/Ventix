# Base de datos (PostgreSQL — Supabase/local/Render, según ambiente)
DATABASE_URL="postgresql://usuario:password@localhost:5432/ventix?schema=public"

# Servidor
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET="cambia-esto-por-un-secreto-real"
JWT_EXPIRES_IN="8h"

# CORS
FRONTEND_URL="http://localhost:5173"

# Email (Resend) — usado para enviar cotizaciones/compras/tickets/reportes por correo
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="BOX POS <no-reply@tu-dominio-verificado.com>"
