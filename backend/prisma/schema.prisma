  creadoEn   DateTime @default(now()) @map("creado_en")

  detalles ConteoDetalle[]

  @@map("conteos_fisicos")
}

model ConteoDetalle {
  id              String  @id @default(uuid())
  conteoId        String  @map("conteo_id")
  articuloId      String  @map("articulo_id")
  cantidadSistema Decimal @map("cantidad_sistema")
  cantidadFisica  Decimal @map("cantidad_fisica")

  conteo ConteoFisico @relation(fields: [conteoId], references: [id])

  @@map("conteos_detalle")
}

model Transferencia {
  id                String   @id @default(uuid())
  empresaId         String   @map("empresa_id")
  sucursalOrigenId  String   @map("sucursal_origen_id")
  sucursalDestinoId String   @map("sucursal_destino_id")
  folio             String?
  estado            String   @default("EN_TRANSITO") // EN_TRANSITO, RECIBIDA (§17.9)
  usuarioId         String   @map("usuario_id")
  creadoEn          DateTime @default(now()) @map("creado_en")

  detalles TransferenciaDetalle[]

  @@map("transferencias")
}

model TransferenciaDetalle {
  id              String  @id @default(uuid())
  transferenciaId String  @map("transferencia_id")
  articuloId      String  @map("articulo_id")
  cantidad        Decimal

  transferencia Transferencia @relation(fields: [transferenciaId], references: [id])

  @@map("transferencias_detalle")
}

// =============================================================================
// MOD-005 COMPRAS
// =============================================================================

enum EstadoCompra {
  CONFIRMADA
  CANCELADA
}

model Compra {
  id             String       @id @default(uuid())
  empresaId      String       @map("empresa_id")
  sucursalId     String       @map("sucursal_id")
  proveedorId    String       @map("proveedor_id")
  usuarioId      String       @map("usuario_id")
  folio          String?
  estado         EstadoCompra @default(CONFIRMADA)
  subtotal       Decimal      @default(0) // sin impuesto — igual que Venta.subtotal (retrocompatible: en compras
  // previas a este campo, subtotal se respalda con total vía backfill de la migración, ver migration.sql)
  impuestos      Decimal      @default(0)
  total          Decimal
  folioProveedor String?      @map("folio_proveedor") // factura/remito del proveedor, solo referencia — no valida unicidad
  observaciones  String?
  // Recepción de una Orden de Compra (opcional — ver OrdenCompra más abajo). Sin @unique a
  // propósito, a diferencia de Venta.facturaId/Cotizacion.convertidaEnVentaId: una orden acepta
  // VARIAS recepciones parciales, así que varias Compra legítimamente comparten el mismo
  // ordenCompraId.
  ordenCompraId  String?      @map("orden_compra_id")
  creadoEn       DateTime     @default(now()) @map("creado_en")

  empresa     Empresa         @relation(fields: [empresaId], references: [id])
  sucursal    Sucursal        @relation(fields: [sucursalId], references: [id])
  proveedor   Proveedor       @relation(fields: [proveedorId], references: [id])
  ordenCompra OrdenCompra?    @relation(fields: [ordenCompraId], references: [id])
  detalles    CompraDetalle[]

  @@map("compras")
}

model CompraDetalle {
  id             String  @id @default(uuid())
  compraId       String  @map("compra_id")
  articuloId     String  @map("articulo_id")
  unidadId       String  @map("unidad_id") // unidad capturada (puede ser alterna)
  cantidad       Decimal
  costo          Decimal // costo unitario congelado, SIN impuesto (§3.14) — igual que VentaDetalle.precio
  descuentoMonto Decimal @default(0) @map("descuento_monto") // solo descuento manual por línea, sin catálogo (Compras no tiene Descuento/Promocion) — mismo criterio que CotizacionDetalle
  impuestoTasa   Decimal @default(0) @map("impuesto_tasa") // tasa del Articulo.impuesto, congelada al registrar la compra

  compra Compra @relation(fields: [compraId], references: [id])

  @@map("compras_detalle")
}

// Orden de Compra: solicitud al proveedor (costo/existencia/disponibilidad), SIN efecto de
// stock ni dinero — mismo rol que Cotizacion frente a Venta, salvo que acá la relación con el
// documento real (Compra, la recepción) es 1-a-N en vez de 1-a-1: una orden puede recibirse en
// varias entregas parciales hasta completarse o cerrarse manualmente. Siempre opcional: una
// Compra puede seguir registrándose sin ninguna orden detrás (compra de mostrador), como ya
// funcionaba antes de este modelo.
enum EstadoOrdenCompra {
  ENVIADA // recién creada — nada recibido todavía
  PARCIAL // al menos una línea con recepción parcial
  RECIBIDA // todas las líneas completaron su cantidad solicitada
  CERRADA // cerrada a mano sin completar (el proveedor no va a mandar el resto)
  CANCELADA // cancelada sin haber recibido nada (solo posible desde ENVIADA)
}

model OrdenCompra {
  id            String            @id @default(uuid())
  empresaId     String            @map("empresa_id")
  sucursalId    String            @map("sucursal_id")
  proveedorId   String            @map("proveedor_id")
  usuarioId     String            @map("usuario_id")
  folio         String?
  estado        EstadoOrdenCompra @default(ENVIADA)
  observaciones String?
  creadoEn      DateTime          @default(now()) @map("creado_en")

  empresa   Empresa              @relation(fields: [empresaId], references: [id])
  sucursal  Sucursal             @relation(fields: [sucursalId], references: [id])
  proveedor Proveedor            @relation(fields: [proveedorId], references: [id])
  detalles  OrdenCompraDetalle[]
  compras   Compra[]

  @@map("ordenes_compra")
}

model OrdenCompraDetalle {
  id                   String   @id @default(uuid())
  ordenCompraId        String   @map("orden_compra_id")
  articuloId           String   @map("articulo_id")
  unidadId             String   @map("unidad_id") // unidad en que se solicitó (solo para mostrarla igual al recibir)
  cantidad             Decimal // cantidad solicitada, en unidadId
  // Cantidad solicitada normalizada a la unidad BASE del artículo, congelada al crear la orden
  // (mismo criterio que impuestoTasa/costo en el resto del proyecto: lo que se pidió no se mueve
  // si alguien reconfigura las unidades alternas del artículo después). Permite comparar contra
  // cantidadRecibidaBase sin volver a resolver el factor cada vez.
  cantidadBase         Decimal  @map("cantidad_base")
  // Acumulado de todo lo recibido contra esta línea (de todas las Compra vinculadas a la orden),
  // siempre en unidad base — cada recepción puede usar una unidad distinta a la solicitada.
  cantidadRecibidaBase Decimal  @default(0) @map("cantidad_recibida_base")
  // Solo referencia para negociar con el proveedor — nunca se usa en ningún cálculo real; el
  // costo de verdad es el que se capture en cada Compra/recepción.
  costoEstimado        Decimal? @map("costo_estimado")

  ordenCompra OrdenCompra @relation(fields: [ordenCompraId], references: [id])

  @@map("ordenes_compra_detalle")
}

// =============================================================================
// MOD-007 CAJA
// =============================================================================

enum TipoMovimientoCaja {
  INGRESO
  RETIRO
  VENTA
  DEVOLUCION
}

model Caja {
  id         String  @id @default(uuid())
  empresaId  String  @map("empresa_id")
  sucursalId String  @map("sucursal_id")
  nombre     String // Caja Principal, Caja 2...
  activa     Boolean @default(true)

  sucursal Sucursal     @relation(fields: [sucursalId], references: [id])
  sesiones SesionCaja[]

  @@map("cajas")
}

model SesionCaja {
  id                   String    @id @default(uuid())
  cajaId               String    @map("caja_id")
  usuarioResponsableId String    @map("usuario_responsable_id")
  fondoInicial         Decimal   @map("fondo_inicial")
  saldoEsperado        Decimal?  @map("saldo_esperado")
  saldoReal            Decimal?  @map("saldo_real")
  diferencia           Decimal?
  abiertaEn            DateTime  @default(now()) @map("abierta_en")
  cerradaEn            DateTime? @map("cerrada_en")

  caja        Caja             @relation(fields: [cajaId], references: [id])
  movimientos MovimientoCaja[]
  ventas      Venta[]

  @@map("sesiones_caja")
}

model MovimientoCaja {
  id              String             @id @default(uuid())
  sesionCajaId    String             @map("sesion_caja_id")
  tipo            TipoMovimientoCaja
  monto           Decimal
  motivo          String?
  referenciaTipo  String?            @map("referencia_tipo")
  referenciaId    String?            @map("referencia_id")
  usuarioId       String             @map("usuario_id")
  autorizadoPorId String?            @map("autorizado_por_id")
  creadoEn        DateTime           @default(now()) @map("creado_en")

  sesionCaja SesionCaja @relation(fields: [sesionCajaId], references: [id])

  @@map("movimientos_caja")
}

// =============================================================================
// MOD-008 VENTAS
// =============================================================================

enum EstadoVenta {
  CONFIRMADA
  CANCELADA
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  MIXTO
}

model Venta {
  id              String      @id @default(uuid())
  empresaId       String      @map("empresa_id")
  sucursalId      String      @map("sucursal_id")
  clienteId       String      @map("cliente_id")
  usuarioId       String      @map("usuario_id")
  sesionCajaId    String      @map("sesion_caja_id")
  folio           String?
  estado          EstadoVenta @default(CONFIRMADA)
  subtotal        Decimal
  impuestos       Decimal
  total           Decimal
  autorizadoPorId String?     @map("autorizado_por_id") // supervisor que autorizó un descuento/promoción que lo requería (opcional)
  // Facturación CFDI: id "suelto" (sin @relation formal, mismo criterio que Cotizacion.convertidaEnVentaId)
  // de la Factura que ya cubre esta venta. null = sin facturar. Se reclama con
  // UPDATE...WHERE factura_id IS NULL, mismo patrón anti-carrera que el resto del proyecto.
  // OJO: a propósito NO es @unique — Factura Global/Consolidada agrupa N ventas bajo UNA
  // factura, así que varias filas de Venta legítimamente comparten el mismo factura_id.
  facturaId       String?     @map("factura_id")
  creadoEn        DateTime    @default(now()) @map("creado_en")

  empresa    Empresa    @relation(fields: [empresaId], references: [id])
  sucursal   Sucursal   @relation(fields: [sucursalId], references: [id])
  cliente    Cliente    @relation(fields: [clienteId], references: [id])
  sesionCaja SesionCaja @relation(fields: [sesionCajaId], references: [id])

  detalles     VentaDetalle[]
  pagos        Pago[]
  devoluciones Devolucion[]

  @@index([facturaId])
  @@map("ventas")
}

model VentaDetalle {
  id               String   @id @default(uuid())
  ventaId          String   @map("venta_id")
  articuloId       String   @map("articulo_id")
  cantidad         Decimal
  precio           Decimal // precio congelado (§20.9, §3.14)
  impuestoTasa     Decimal  @map("impuesto_tasa") // tasa congelada al momento de la venta
  cantidadDevuelta Decimal  @default(0) @map("cantidad_devuelta")
  descuentoId      String?  @map("descuento_id")
  promocionId      String?  @map("promocion_id")
  descuentoMonto   Decimal  @default(0) @map("descuento_monto") // monto restado de esta línea
  // Costo unitario del artículo (Articulo.costo) congelado al momento de la venta, igual que
  // impuestoTasa — Articulo.costo cambia con el tiempo, así que "Utilidad" necesita el valor
  // vigente en ese momento, no el actual. Null en ventas anteriores a este campo (no hay forma
  // confiable de reconstruir el costo histórico) — los reportes que lo usan excluyen esas líneas
  // y lo marcan explícitamente en vez de aproximar con el costo de hoy.
  costoUnitario    Decimal? @map("costo_unitario")

  venta     Venta      @relation(fields: [ventaId], references: [id])
  descuento Descuento? @relation(fields: [descuentoId], references: [id])
  promocion Promocion? @relation(fields: [promocionId], references: [id])

  @@map("ventas_detalle")
}

model Pago {
  id      String     @id @default(uuid())
  ventaId String     @map("venta_id")
  metodo  MetodoPago
  monto   Decimal

  venta Venta @relation(fields: [ventaId], references: [id])

  @@map("pagos")
}

model Devolucion {
  id              String   @id @default(uuid())
  ventaId         String   @map("venta_id")
  folio           String?
  motivo          String // producto defectuoso, error de venta, cliente cambió de opinión, garantía, otro
  usuarioId       String   @map("usuario_id")
  autorizadoPorId String   @map("autorizado_por_id")
  reembolso       Decimal  @default(0)
  creadoEn        DateTime @default(now()) @map("creado_en")

  venta    Venta               @relation(fields: [ventaId], references: [id])
  detalles DevolucionDetalle[]

  @@map("devoluciones")
}

model DevolucionDetalle {
  id           String  @id @default(uuid())
  devolucionId String  @map("devolucion_id")
  articuloId   String  @map("articulo_id")
  cantidad     Decimal
  vuelveAStock Boolean @default(true) @map("vuelve_a_stock") // false si es defectuoso (§26.6, PENDIENTE-005)

  devolucion Devolucion @relation(fields: [devolucionId], references: [id])

  @@map("devoluciones_detalle")
}

// VIGENTE/CONVERTIDA/CANCELADA son los únicos estados persistidos. "Expirada" NO es un estado
// propio — se deriva en tiempo de consulta de VIGENTE + vigencia < hoy (ver
// cotizaciones.service.js#listar), igual que ya lo calculaba el frontend antes de este campo.
enum CotizacionEstado {
  VIGENTE
  CONVERTIDA
  CANCELADA
}

model Cotizacion {
  id                  String           @id @default(uuid())
  empresaId           String           @map("empresa_id")
  sucursalId          String           @map("sucursal_id")
  clienteId           String           @map("cliente_id")
  usuarioId           String           @map("usuario_id")
  folio               String?
  total               Decimal // con impuesto incluido — igual que Venta.total (ver cotizaciones.service.js#crear)
  convertidaEnVentaId String?          @map("convertida_en_venta_id")
  estado              CotizacionEstado @default(VIGENTE)
  vigencia            DateTime? // fecha límite de validez (solo calendario, sin hora) — opcional
  observaciones       String?
  creadoEn            DateTime         @default(now()) @map("creado_en")

  detalles CotizacionDetalle[]

  @@map("cotizaciones")
}

model CotizacionDetalle {
  id             String  @id @default(uuid())
  cotizacionId   String  @map("cotizacion_id")
  articuloId     String  @map("articulo_id")
  cantidad       Decimal
  precio         Decimal
  descuentoMonto Decimal @default(0) @map("descuento_monto") // solo descuento manual (%/monto), sin catálogo — ver ventas.service.js#resolverDescuentoLinea (rama descuentoManual)
  impuestoTasa   Decimal @default(0) @map("impuesto_tasa") // congelada al crear la cotización (igual que VentaDetalle) — ver Cotizacion.total

  cotizacion Cotizacion @relation(fields: [cotizacionId], references: [id])

  @@map("cotizaciones_detalle")
}

// =============================================================================
// MOD-FACTURACION — CFDI (México). Fase A: solo esquema local + catálogos SAT.
// El timbrado real contra un PAC se integra en una fase final aparte (uuid/xml/sello
// abajo quedan reservados, sin lógica todavía, para no requerir una segunda migración
// disruptiva cuando llegue esa fase).
// =============================================================================

// Catálogo genérico para los ~9 catálogos oficiales del SAT (RegimenFiscal, UsoCfdi,
// FormaPago, Moneda, Pais, TipoFactor, ObjetoImp, Impuesto, MotivoCancelacion,
// Periodicidad, Meses, ClaveProdServ, ClaveUnidad). Una sola tabla en vez de un modelo
// por catálogo porque el SAT los actualiza con cierta frecuencia y varían mucho en
// tamaño (de 3 filas hasta ~52,000 en ClaveProdServ) — se siembran/resiembran desde
// los archivos oficiales que publica el SAT.
model CatalogoSat {
  id          String  @id @default(uuid())
  tipo        String // RegimenFiscal | UsoCfdi | FormaPago | Moneda | Pais | TipoFactor |
  // ObjetoImp | Impuesto | MotivoCancelacion | Periodicidad | Meses |
  // ClaveProdServ | ClaveUnidad
  clave       String
  descripcion String
  activo      Boolean @default(true)
  metadata    Json? // datos propios del catálogo, ej. UsoCfdi: {aplicaPersonaFisica, aplicaPersonaMoral}

  @@unique([tipo, clave])
  @@index([tipo, descripcion])
  @@map("catalogos_sat")
}

enum TipoFactura {
  DIRECTA // emisión libre, sin venta previa del POS
  VENTA_POS // convierte una venta existente del POS
  AUTOFACTURACION // el cliente factura su propia compra desde el portal público
  GLOBAL // agrupa ventas de público en general (RFC genérico) — requiere InformacionGlobal
  CONSOLIDADA_CLIENTE // agrupa varias ventas de UN cliente identificado en un solo CFDI
}

enum EstadoFactura {
  BORRADOR
  PENDIENTE // lista para timbrar, aún no enviada al PAC
  TIMBRADA
  CANCELADA
  ERROR
}

model Factura {
  id         String        @id @default(uuid())
  empresaId  String        @map("empresa_id")
  sucursalId String        @map("sucursal_id")
  clienteId  String?       @map("cliente_id") // trazabilidad/reportes; el receptor real va congelado abajo (ver Cliente)
  tipo       TipoFactura
  estado     EstadoFactura @default(BORRADOR)
  serie      String?
  folio      String?

  // Receptor — snapshot congelado al momento de facturar (mismo criterio que
  // VentaDetalle.precio/.impuestoTasa: no lee del Cliente en vivo, porque Directa/
  // Autofacturación pueden no tener un Cliente guardado y porque el régimen/domicilio
  // del cliente puede cambiar después sin que eso deba alterar una factura ya emitida).
  rfcReceptor               String @map("rfc_receptor")
  nombreReceptor            String @map("nombre_receptor")
  regimenFiscalReceptor     String @map("regimen_fiscal_receptor")
  usoCfdi                   String @map("uso_cfdi")
  domicilioFiscalReceptorCp String @map("domicilio_fiscal_receptor_cp")

  // Emisor — congelado igual, resuelto como sucursal.<campo> ?? empresa.<campo>
  rfcEmisor           String @map("rfc_emisor")
  razonSocialEmisor   String @map("razon_social_emisor")
  regimenFiscalEmisor String @map("regimen_fiscal_emisor")
  lugarExpedicion     String @map("lugar_expedicion") // CP de la sucursal, sin fallback

  formaPago  String   @map("forma_pago") // c_FormaPago (en ventas MIXTO: la del monto mayor)
  metodoPago String   @map("metodo_pago") // PUE | PPD
  moneda     String   @default("MXN")
  tipoCambio Decimal? @map("tipo_cambio")

  subtotal                  Decimal
  totalDescuento            Decimal @default(0) @map("total_descuento")
  totalImpuestosTrasladados Decimal @default(0) @map("total_impuestos_trasladados")
  totalImpuestosRetenidos   Decimal @default(0) @map("total_impuestos_retenidos")
  total                     Decimal

  // Solo aplica cuando tipo = GLOBAL (CFDI 4.0 exige este nodo con RFC genérico)
  informacionGlobalPeriodicidad String? @map("informacion_global_periodicidad") // c_Periodicidad
  informacionGlobalMeses        String? @map("informacion_global_meses") // c_Meses
  informacionGlobalAnio         Int?    @map("informacion_global_anio")

  // Cancelación (CFDI 4.0 exige motivo; "01" requiere la factura que la sustituye)
  claveMotivoCancelacion String? @map("clave_motivo_cancelacion")
  facturaSustitutaId     String? @map("factura_sustituta_id") // id "suelto", sin @relation (mismo criterio que referenciaId en otros módulos)

  // Fase F: integración real con el PAC (Facturama).
  uuid             String?   @unique // Folio Fiscal asignado por el SAT
  xmlTimbrado      String?   @map("xml_timbrado") // XML timbrado completo, base64 tal cual lo devuelve el PAC
  cadenaOriginal   String?   @map("cadena_original")
  selloSAT         String?   @map("sello_sat")
  noCertificadoSAT String?   @map("no_certificado_sat")
  fechaTimbrado    DateTime? @map("fecha_timbrado")
  // Id interno del PAC para este documento -- lo exige Facturama para descargar el XML o
  // cancelar (el UUID del SAT solo no alcanza, confirmado contra su sandbox real). "Suelto"
  // sin @relation, mismo criterio que el resto de los ids externos del proyecto.
  pacId            String?   @map("pac_id")

  usuarioId     String   @map("usuario_id")
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  empresa  Empresa  @relation(fields: [empresaId], references: [id])
  sucursal Sucursal @relation(fields: [sucursalId], references: [id])
  cliente  Cliente? @relation(fields: [clienteId], references: [id])

  detalles FacturaDetalle[]
  ventas   FacturaVenta[] // 1 fila para VENTA_POS/AUTOFACTURACION, N para GLOBAL/CONSOLIDADA_CLIENTE

  @@map("facturas")
}

// Fase F: qué RFC de esta empresa ya tiene un CSD (Certificado de Sello Digital) registrado en
// el PAC. Deliberadamente NO guarda el certificado ni la llave privada -- esos viajan directo a
// la API del PAC (Facturama) y se registran ahí, esta tabla solo trackea metadata para poder
// mostrar "CSD cargado, vence tal fecha" en la UI y bloquear el timbrado si falta o venció.
model FacturaCsd {
  id            String   @id @default(uuid())
  empresaId     String   @map("empresa_id")
  rfc           String
  vigenciaHasta DateTime @map("vigencia_hasta")
  registradoEn  DateTime @default(now()) @map("registrado_en")

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, rfc])
  @@map("facturas_csd")
}

// Une Factura <-> Venta(s) del POS. Sirve tanto para "facturar una venta" (1 fila) como
// para Global/Consolidada (N filas, una por venta agrupada). ventaId queda "suelto" (sin
// @relation formal hacia Venta), mismo criterio que referenciaId en MovimientoInventario/
// MovimientoCaja para no acoplar el módulo de Facturación al de Ventas vía Prisma.
model FacturaVenta {
  id        String @id @default(uuid())
  facturaId String @map("factura_id")
  ventaId   String @map("venta_id")

  factura Factura @relation(fields: [facturaId], references: [id])

  @@unique([ventaId]) // una venta no puede estar en más de una factura vigente
  @@map("facturas_ventas")
}

model FacturaDetalle {
  id               String  @id @default(uuid())
  facturaId        String  @map("factura_id")
  articuloId       String? @map("articulo_id") // suelto, sin @relation (mismo criterio que VentaDetalle.articuloId) — nullable porque Directa/Global pueden no mapear a un Articulo interno
  claveProdServSat String  @map("clave_prod_serv_sat") // congelado del Articulo al momento de facturar
  claveUnidadSat   String  @map("clave_unidad_sat")
  descripcion      String
  cantidad         Decimal
  valorUnitario    Decimal @map("valor_unitario")
  importe          Decimal
  descuento        Decimal @default(0)
  objetoImpuesto   String  @map("objeto_impuesto") // c_ObjetoImp

  factura   Factura                  @relation(fields: [facturaId], references: [id])
  impuestos FacturaDetalleImpuesto[]

  @@map("facturas_detalle")
}

enum TipoImpuestoCfdi {
  TRASLADO
  RETENCION
}

model FacturaDetalleImpuesto {
  id               String           @id @default(uuid())
  facturaDetalleId String           @map("factura_detalle_id")
  tipo             TipoImpuestoCfdi
  impuestoClaveSat String           @map("impuesto_clave_sat") // c_Impuesto: 001 ISR, 002 IVA, 003 IEPS
  tipoFactorSat    String           @map("tipo_factor_sat") // c_TipoFactor: Tasa | Cuota | Exento
  base             Decimal
  tasaOCuota       Decimal?         @map("tasa_o_cuota")
  importe          Decimal?

  detalle FacturaDetalle @relation(fields: [facturaDetalleId], references: [id])

  @@map("facturas_detalle_impuestos")
}

// Fase 2 de "captura rápida" (ver Fase 1: Factura.obtenerSugerencia sugiriendo repetir la
// última factura). Una plantilla es un "pedido tipo" nombrado para un cliente en una sucursal
// puntual -- misma granularidad que la sugerencia de Fase 1. Solo conceptos ligados a un
// Articulo del catálogo (sin freeform): al aplicarla se resuelve SIEMPRE el precio/clave SAT
// EN VIVO del Articulo, nunca un valor guardado acá -- mismo criterio que Cliente.listaPrecioId,
// para que una plantilla vieja no "resucite" un precio desactualizado.
model FacturaPlantilla {
  id               String    @id @default(uuid())
  empresaId        String    @map("empresa_id")
  sucursalId       String    @map("sucursal_id")
  clienteId        String    @map("cliente_id")
  nombre           String
  formaPago        String?   @map("forma_pago")
  metodoPago       String?   @map("metodo_pago")
  esPredeterminada Boolean   @default(false) @map("es_predeterminada")
  usoContador      Int       @default(0) @map("uso_contador")
  ultimoUso        DateTime? @map("ultimo_uso")
  creadoEn         DateTime  @default(now()) @map("creado_en")

  empresa   Empresa                    @relation(fields: [empresaId], references: [id])
  sucursal  Sucursal                   @relation(fields: [sucursalId], references: [id])
  cliente   Cliente                    @relation(fields: [clienteId], references: [id])
  conceptos FacturaPlantillaConcepto[]

  @@map("facturas_plantillas")
}

model FacturaPlantillaConcepto {
  id                 String  @id @default(uuid())
  facturaPlantillaId String  @map("factura_plantilla_id")
  articuloId         String  @map("articulo_id") // suelto, sin @relation -- mismo criterio que FacturaDetalle.articuloId
  cantidadHabitual   Decimal @default(1) @map("cantidad_habitual")
  orden              Int     @default(0)

  facturaPlantilla FacturaPlantilla @relation(fields: [facturaPlantillaId], references: [id])

  @@map("facturas_plantillas_detalle")
}
