  ajusteId   String  @map("ajuste_id")
  articuloId String  @map("articulo_id")
  cantidad   Decimal // positivo = entrada, negativo = salida

  ajuste Ajuste @relation(fields: [ajusteId], references: [id])

  @@map("ajustes_detalle")
}

model ConteoFisico {
  id         String   @id @default(uuid())
  empresaId  String   @map("empresa_id")
  sucursalId String   @map("sucursal_id")
  usuarioId  String   @map("usuario_id")
