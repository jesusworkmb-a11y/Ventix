  // Facturación CFDI: solo defaults para prellenar el formulario al facturar — la Factura
  // siempre congela su propia copia del receptor (ver Factura), esto no es fuente de verdad.
  regimenFiscalClave String? @map("regimen_fiscal_clave")
  usoCfdiPreferido   String? @map("uso_cfdi_preferido")
  domicilioFiscalCp  String? @map("domicilio_fiscal_cp")

  empresa            Empresa            @relation(fields: [empresaId], references: [id])
