// =============================================================================
// MOD-006 INVENTARIO (se define antes que Compras/Ventas porque ambas dependen de él)
// =============================================================================

enum TipoMovimientoInventario {
  ENTRADA_COMPRA
  SALIDA_VENTA
  ENTRADA_DEVOLUCION
  AJUSTE_ENTRADA
  AJUSTE_SALIDA
  INVENTARIO_INICIAL
  TRANSFERENCIA_SALIDA
  TRANSFERENCIA_ENTRADA
  CANCELACION_COMPRA
  CANCELACION_VENTA
}

model Existencia {
