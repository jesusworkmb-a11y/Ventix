  empresaId  String  @map("empresa_id")
  sucursalId String  @map("sucursal_id")
  articuloId String  @map("articulo_id")
  cantidad   Decimal @default(0) // siempre expresada en unidad base (§11.1)

  empresa  Empresa  @relation(fields: [empresaId], references: [id])
  sucursal Sucursal @relation(fields: [sucursalId], references: [id])
  articulo Articulo @relation(fields: [articuloId], references: [id])

  @@unique([sucursalId, articuloId])
  @@map("existencias")
}

// Kardex — inmutable (§17.3, §3.14)
model MovimientoInventario {
  id             String                   @id @default(uuid())
  empresaId      String                   @map("empresa_id")
  sucursalId     String                   @map("sucursal_id")
  articuloId     String                   @map("articulo_id")
  tipo           TipoMovimientoInventario
  cantidad       Decimal // positivo en unidad base
  referenciaTipo String                   @map("referencia_tipo") // Compra, Venta, Ajuste, Transferencia...
  referenciaId   String                   @map("referencia_id")
  usuarioId      String                   @map("usuario_id")
  creadoEn       DateTime                 @default(now()) @map("creado_en")

  @@index([empresaId, sucursalId, articuloId])
