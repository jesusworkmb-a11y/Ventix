// =============================================================================
// BOX POS (ex-Ventix) — schema.prisma (borrador inicial, Fase 0)
// Fuente: VENTIX_ESPECIFICACION_MAESTRA_INTEGRAL_V1.md + VENTIX_BASE_TECNICA_CONSOLIDADA_V1.md
//
// Estado: PENDIENTE-011 (modelo físico) — este archivo es el entregable que lo resuelve.
// No introduce funcionalidad nueva; traduce a físico el modelo lógico ya aprobado (§3.10-3.14).
// Todo lo marcado "// REVISAR" es una decisión técnica tomada para poder avanzar,
// documentada aquí para tu validación (no altera comportamiento de negocio).
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// MOD-001 CORE
// =============================================================================

enum EstadoGeneral {
  ACTIVA
  SUSPENDIDA
  ARCHIVADA
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO
  BLOQUEADO
}

// Plantillas de PDF (§Plantillas de documentos, ver frontend/src/shared/pdf/plantillas):
// una por empresa, aplica a Cotización/Compra/Orden de compra/Factura CFDI.
enum PlantillaPdf {
  CLASICA
  MODERNA
  EJECUTIVA
  COMERCIAL
  CATALOGO
  PREMIUM
}

model Empresa {
  id                     String        @id @default(uuid())
  nombreComercial        String        @map("nombre_comercial")
  razonSocial            String?       @map("razon_social")
  rfc                    String?
  pais                   String
  moneda                 String
  zonaHoraria            String        @map("zona_horaria")
  correo                 String?
  telefono               String?
  sitioWeb               String?       @map("sitio_web")
  logoUrl                String?       @map("logo_url")
  // Facturación CFDI (§Facturación): régimen fiscal del emisor (c_RegimenFiscal SAT).
  // Sucursal puede sobreescribirlo (null = hereda el de acá) para el caso de sucursales
  // que facturan bajo un RFC/razón social propios.
  regimenFiscalClave     String?       @map("regimen_fiscal_clave")
  // Slug de la URL pública del portal de autofacturación (/facturar/:slug). null = portal apagado.
  slugPublico            String?       @unique @map("slug_publico")
  estado                 EstadoGeneral @default(ACTIVA)
  // Branding de documentos PDF (§Plantillas de documentos): colores libres en hex, sin
  // validar contra una paleta fija — cada plantilla ya trae sus propios defaults si la
  // empresa no personalizó nada (ver frontend/src/shared/pdf/plantillas).
  colorPrimario          String?       @map("color_primario")
  colorSecundario        String?       @map("color_secundario")
  colorAcento            String?       @map("color_acento")
  plantillaPdf           PlantillaPdf  @default(CLASICA) @map("plantilla_pdf")
  // Texto libre reusado en el pie de página de Cotización/Compra/Orden de compra (no de
  // Factura CFDI, que solo lleva los elementos que exige el SAT). Distinto de
  // Cotizacion.observaciones/Compra.observaciones, que son por documento.
  datosBancarios         String?       @map("datos_bancarios")
  terminosCondicionesPdf String?       @map("terminos_condiciones_pdf")
  creadoEn               DateTime      @default(now()) @map("creado_en")
  actualizadoEn          DateTime      @updatedAt @map("actualizado_en")

  sucursales         Sucursal[]
  usuariosEmpresa    UsuarioEmpresa[]
  roles              Rol[]
  configuraciones    Configuracion[]
  secuencias         Secuencia[]
  auditorias         Auditoria[]
  notificaciones     NotificacionInterna[]
  articulos          Articulo[]
  categorias         Categoria[]
  marcas             Marca[]
  unidades           Unidad[]
  impuestos          Impuesto[]
  listasPrecio       ListaPrecio[]
  descuentos         Descuento[]
  promociones        Promocion[]
  atributos          Atributo[]
  clientes           Cliente[]
  proveedores        Proveedor[]
  compras            Compra[]
  ordenesCompra      OrdenCompra[]
  existencias        Existencia[]
  ventas             Venta[]
  facturas           Factura[]
  facturasPlantillas FacturaPlantilla[]
  facturasCsd        FacturaCsd[]

  @@map("empresas")
}

model Sucursal {
  id          String        @id @default(uuid())
  empresaId   String        @map("empresa_id")
  nombre      String
  clave       String
  telefono    String?
  correo      String?
  direccion   String?
  responsable String?
  estado      EstadoGeneral @default(ACTIVA)
  creadoEn    DateTime      @default(now()) @map("creado_en")

  // Facturación CFDI: null = hereda el dato de Empresa (comportamiento "matriz").
  // Con valor propio, esta sucursal emite bajo su propio RFC/razón social/régimen
  // (ej. una sucursal que opera como entidad legal separada).
  rfc                String? @map("rfc")
  razonSocial        String? @map("razon_social")
  regimenFiscalClave String? @map("regimen_fiscal_clave")
  // Lugar de expedición del CFDI (código postal). Sin fallback: cada punto de
  // expedición tiene el suyo. Obligatorio solo si la sucursal va a facturar.
  codigoPostal       String? @map("codigo_postal")

  empresa            Empresa            @relation(fields: [empresaId], references: [id])
  cajas              Caja[]
  existencias        Existencia[]
  ventas             Venta[]
  compras            Compra[]
  ordenesCompra      OrdenCompra[]
  usuariosSucursal   UsuarioSucursal[]
  facturas           Factura[]
  facturasPlantillas FacturaPlantilla[]

  @@unique([empresaId, clave])
  @@map("sucursales")
}

model Usuario {
  id               String        @id @default(uuid())
  nombre           String
  correo           String
  passwordHash     String        @map("password_hash")
  telefono         String?
  estado           EstadoUsuario @default(ACTIVO)
  ultimoAcceso     DateTime?     @map("ultimo_acceso")
  intentosFallidos Int           @default(0) @map("intentos_fallidos")
  bloqueadoHasta   DateTime?     @map("bloqueado_hasta")
  // Dueño de la plataforma Ventix (yo), no de una empresa cliente — administra el panel de
  // tenants en /core/superadmin sin pasar por UsuarioEmpresa/Rol de ninguna empresa.
  esSuperAdmin     Boolean       @default(false) @map("es_super_admin")
  creadoEn         DateTime      @default(now()) @map("creado_en")

  empresas          UsuarioEmpresa[]
  sucursales        UsuarioSucursal[]
  permisosExcepcion PermisoUsuarioExcepcion[]

  @@unique([correo]) // VALIDADO: correo único global (multi-empresa vía UsuarioEmpresa), confirmado por el usuario.
  @@map("usuarios")
}

model UsuarioEmpresa {
  id        String  @id @default(uuid())
  usuarioId String  @map("usuario_id")
  empresaId String  @map("empresa_id")
  rolId     String  @map("rol_id")
  activo    Boolean @default(true)

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  empresa Empresa @relation(fields: [empresaId], references: [id])
  rol     Rol     @relation(fields: [rolId], references: [id])

  @@unique([usuarioId, empresaId])
  @@map("usuarios_empresas")
}

model UsuarioSucursal {
  id         String @id @default(uuid())
  usuarioId  String @map("usuario_id")
  sucursalId String @map("sucursal_id")

  usuario  Usuario  @relation(fields: [usuarioId], references: [id])
  sucursal Sucursal @relation(fields: [sucursalId], references: [id])

  @@unique([usuarioId, sucursalId])
  @@map("usuarios_sucursales")
}

model Rol {
  id        String @id @default(uuid())
  empresaId String @map("empresa_id")
  nombre    String // Administrador, Supervisor, Cajero, Almacenista, o personalizado

  empresa  Empresa          @relation(fields: [empresaId], references: [id])
  usuarios UsuarioEmpresa[]
  permisos RolPermiso[]

  @@unique([empresaId, nombre])
  @@map("roles")
}

model Permiso {
  id     String @id @default(uuid())
  clave  String @unique // ej. venta.modificar_precio, caja.retiro, inventario.ajustar
  grupo  String // agrupación visual: Ventas, Caja, Inventario, Compras, Administración...
  nombre String

  roles       RolPermiso[]
  excepciones PermisoUsuarioExcepcion[]

  @@map("permisos")
}

model RolPermiso {
  id        String @id @default(uuid())
  rolId     String @map("rol_id")
  permisoId String @map("permiso_id")

  rol     Rol     @relation(fields: [rolId], references: [id])
  permiso Permiso @relation(fields: [permisoId], references: [id])

  @@unique([rolId, permisoId])
  @@map("roles_permisos")
}

// Permiso individual que puede prevalecer sobre el rol (§7.4)
model PermisoUsuarioExcepcion {
  id        String  @id @default(uuid())
  usuarioId String  @map("usuario_id")
  permisoId String  @map("permiso_id")
  concedido Boolean // true = otorga aunque el rol no lo tenga; false = revoca aunque el rol lo tenga

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  permiso Permiso @relation(fields: [permisoId], references: [id])

  @@unique([usuarioId, permisoId])
  @@map("permisos_usuario_excepciones")
}

model Configuracion {
  id        String @id @default(uuid())
  empresaId String @map("empresa_id")
  clave     String
  valor     String // VALIDADO: JSON serializado como texto (no tipo Json nativo), confirmado por el usuario para V1.

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, clave])
  @@map("configuraciones")
}

// Folios (§9): un tipo de documento por sucursal tiene su propia secuencia
model Secuencia {
  id              String  @id @default(uuid())
  empresaId       String  @map("empresa_id")
  sucursalId      String? @map("sucursal_id") // null si la secuencia es a nivel empresa
  tipoDocumento   String  @map("tipo_documento") // VTA, COM, TRA, DEV, COT, AJU...
  prefijo         String
  siguienteNumero Int     @default(1) @map("siguiente_numero")

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, sucursalId, tipoDocumento])
  @@map("secuencias")
}

model Auditoria {
  id                   String   @id @default(uuid())
  empresaId            String   @map("empresa_id")
  sucursalId           String?  @map("sucursal_id")
  usuarioEjecutorId    String   @map("usuario_ejecutor_id")
  usuarioAutorizadorId String?  @map("usuario_autorizador_id")
  accion               String
  entidad              String
  entidadId            String?  @map("entidad_id")
  folio                String?
  motivo               String?
  valoresAntes         Json?    @map("valores_antes")
  valoresDespues       Json?    @map("valores_despues")
  creadoEn             DateTime @default(now()) @map("creado_en")

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@index([empresaId, entidad, entidadId])
  @@map("auditorias")
}

model NotificacionInterna {
  id        String   @id @default(uuid())
  empresaId String   @map("empresa_id")
  tipo      String // STOCK_MINIMO, SIN_EXISTENCIA, STOCK_MAXIMO, etc.
  mensaje   String
  leida     Boolean  @default(false)
  creadoEn  DateTime @default(now()) @map("creado_en")

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@map("notificaciones_internas")
}

// =============================================================================
// MOD-002 CATÁLOGO
// =============================================================================

enum TipoArticulo {
  PRODUCTO
  SERVICIO
  KIT
}

model Categoria {
  id               String  @id @default(uuid())
  empresaId        String  @map("empresa_id")
  nombre           String
  categoriaPadreId String? @map("categoria_padre_id") // hasta 2 niveles (§10.6)

  empresa        Empresa     @relation(fields: [empresaId], references: [id])
  categoriaPadre Categoria?  @relation("SubCategorias", fields: [categoriaPadreId], references: [id])
  subcategorias  Categoria[] @relation("SubCategorias")
  articulos      Articulo[]
  descuentos     Descuento[]
  promociones    Promocion[]

  // Nombre único por empresa dentro del mismo padre (permite reusar un nombre de
  // subcategoría bajo padres distintos). No cubre la carrera entre dos categorías raíz
  // (categoriaPadreId null) con el mismo nombre — Postgres trata NULL como distinto de
  // NULL en un unique constraint; el pre-chequeo en el service cubre el caso normal.
  @@unique([empresaId, categoriaPadreId, nombre])
  @@map("categorias")
}

model Marca {
  id        String @id @default(uuid())
  empresaId String @map("empresa_id")
  nombre    String

  empresa   Empresa    @relation(fields: [empresaId], references: [id])
  articulos Articulo[]

  @@unique([empresaId, nombre])
  @@map("marcas")
}

model Unidad {
  id             String  @id @default(uuid())
  empresaId      String  @map("empresa_id")
  nombre         String // Pieza, Caja, Kilogramo...
  abreviatura    String?
  claveUnidadSat String? @map("clave_unidad_sat") // c_ClaveUnidad SAT, ej. "H87", "E48"

  empresa          Empresa         @relation(fields: [empresaId], references: [id])
  articulosBase    Articulo[]      @relation("UnidadBase")
  unidadesAlternas UnidadAlterna[]

  @@unique([empresaId, nombre])
  @@map("unidades")
}

// Unidad alterna + factor de conversión hacia la unidad base del artículo (§11)
model UnidadAlterna {
  id         String  @id @default(uuid())
  articuloId String  @map("articulo_id")
  unidadId   String  @map("unidad_id")
  factor     Decimal // cuántas unidades base equivalen a 1 de esta unidad alterna

  articulo Articulo @relation(fields: [articuloId], references: [id])
  unidad   Unidad   @relation(fields: [unidadId], references: [id])

  @@unique([articuloId, unidadId])
  @@map("unidades_alternas")
}

model Impuesto {
  id               String  @id @default(uuid())
  empresaId        String  @map("empresa_id")
  nombre           String // IVA 16%, IVA 8%, Exento
  tasa             Decimal // 0.16, 0.08, 0.00
  // Facturación CFDI: mapeo de este impuesto local a la clave SAT correspondiente.
  claveImpuestoSat String  @default("002") @map("clave_impuesto_sat") // c_Impuesto: 001 ISR, 002 IVA, 003 IEPS
  tipoFactorSat    String  @default("Tasa") @map("tipo_factor_sat") // c_TipoFactor: Tasa | Cuota | Exento

  empresa   Empresa    @relation(fields: [empresaId], references: [id])
  articulos Articulo[]

  @@unique([empresaId, nombre])
  @@map("impuestos")
}

model Articulo {
  id               String       @id @default(uuid())
  empresaId        String       @map("empresa_id")
  tipo             TipoArticulo
  clave            String? // clave/código interno
  sku              String?
  codigoBarras     String?      @map("codigo_barras")
  nombre           String
  descripcion      String?
  categoriaId      String?      @map("categoria_id")
  marcaId          String?      @map("marca_id")
  unidadBaseId     String       @map("unidad_base_id")
  impuestoId       String?      @map("impuesto_id")
  costo            Decimal      @default(0) // último costo (§16.3)
  precio           Decimal      @default(0)
  stockMinimo      Decimal?     @map("stock_minimo")
  stockMaximo      Decimal?     @map("stock_maximo")
  imagenUrl        String?      @map("imagen_url")
  claveProdServSat String?      @map("clave_prod_serv_sat") // c_ClaveProdServ SAT, ej. "83111603"
  activo           Boolean      @default(true)
  // Variantes (color/talla/etc.): una variante es otro Articulo, enlazado a su producto padre
  // acá. null = artículo normal o producto padre; no-null = es una variante de ese padre.
  articuloPadreId  String?      @map("articulo_padre_id")
  creadoEn         DateTime     @default(now()) @map("creado_en")

  empresa    Empresa    @relation(fields: [empresaId], references: [id])
  categoria  Categoria? @relation(fields: [categoriaId], references: [id])
  marca      Marca?     @relation(fields: [marcaId], references: [id])
  unidadBase Unidad     @relation("UnidadBase", fields: [unidadBaseId], references: [id])
  impuesto   Impuesto?  @relation(fields: [impuestoId], references: [id])

  articuloPadre Articulo?  @relation("Variantes", fields: [articuloPadreId], references: [id])
  variantes     Articulo[] @relation("Variantes")

  unidadesAlternas UnidadAlterna[]
  precios          PrecioArticulo[]
  existencias      Existencia[]
  proveedores      ArticuloProveedor[]
  descuentos       Descuento[]
  promociones      Promocion[]
  valoresAtributo  ArticuloValorAtributo[]

  // Kits (tipo KIT, agregado 2026-08-16): qué otros artículos lo componen (`kitComponentes`,
  // esta fila es el kit) y en qué kits participa como pieza (`usadoEnKits`, esta fila es el
  // componente). Ver ArticuloKitDetalle.
  kitComponentes ArticuloKitDetalle[] @relation("Kit")
  usadoEnKits    ArticuloKitDetalle[] @relation("ComponenteDeKit")

  @@unique([empresaId, sku])
  @@unique([empresaId, codigoBarras])
  @@map("articulos")
}

// Composición de un Articulo tipo KIT: qué artículos lo integran y en qué cantidad (en la
// unidad base de cada componente). Un Kit no lleva Existencia propia — venderlo/devolverlo
// descuenta/acredita stock de cada componente vía aplicarMovimiento (shared/services/
// inventario.service.js), que expande automáticamente cualquier movimiento sobre un artículo
// tipo KIT en uno por componente. El componente siempre debe ser tipo PRODUCTO (validado en
// articulos.service.js#setKitDetalle) — sin kits anidados ni componentes tipo Servicio.
model ArticuloKitDetalle {
  id                   String  @id @default(uuid())
  kitId                String  @map("kit_id")
  articuloComponenteId String  @map("articulo_componente_id")
  cantidad             Decimal

  kit                Articulo @relation("Kit", fields: [kitId], references: [id])
  articuloComponente Articulo @relation("ComponenteDeKit", fields: [articuloComponenteId], references: [id])

  @@unique([kitId, articuloComponenteId])
  @@map("articulos_kit_detalle")
}

// Catálogo reusable de atributos de variante (§ Variantes, agregado 2026-08-11): "Color",
// "Talla"... cada valor puede asignarse a cualquier variante de cualquier artículo.
model Atributo {
  id        String @id @default(uuid())
  empresaId String @map("empresa_id")
  nombre    String // "Color", "Talla"

  empresa Empresa         @relation(fields: [empresaId], references: [id])
  valores ValorAtributo[]

  @@unique([empresaId, nombre])
  @@map("atributos")
}

model ValorAtributo {
  id         String @id @default(uuid())
  atributoId String @map("atributo_id")
  valor      String // "Rojo", "M"

  atributo Atributo                @relation(fields: [atributoId], references: [id])
  usos     ArticuloValorAtributo[]

  @@unique([atributoId, valor])
  @@map("valores_atributo")
}

// Qué combinación de valores identifica a una variante (Articulo con articuloPadreId != null).
model ArticuloValorAtributo {
  id              String @id @default(uuid())
  articuloId      String @map("articulo_id")
  valorAtributoId String @map("valor_atributo_id")

  articulo      Articulo      @relation(fields: [articuloId], references: [id])
  valorAtributo ValorAtributo @relation(fields: [valorAtributoId], references: [id])

  @@unique([articuloId, valorAtributoId])
  @@map("articulo_valores_atributo")
}

model ListaPrecio {
  id        String  @id @default(uuid())
  empresaId String  @map("empresa_id")
  nombre    String // ej. Menudeo (base), Mayoreo
  esBase    Boolean @default(false) @map("es_base")

  empresa  Empresa          @relation(fields: [empresaId], references: [id])
  precios  PrecioArticulo[]
  clientes Cliente[]

  @@unique([empresaId, nombre])
  @@map("listas_precio")
}

model PrecioArticulo {
  id            String  @id @default(uuid())
  articuloId    String  @map("articulo_id")
  listaPrecioId String  @map("lista_precio_id")
  precio        Decimal

  articulo    Articulo    @relation(fields: [articuloId], references: [id])
  listaPrecio ListaPrecio @relation(fields: [listaPrecioId], references: [id])

  @@unique([articuloId, listaPrecioId])
  @@map("precios_articulo")
}

enum TipoDescuento {
  PORCENTAJE
  MONTO_FIJO
}

enum AlcanceDescuento {
  TODOS
  CATEGORIA
  ARTICULO
}

// Descuento preconfigurado que el cajero elige en Ventas (no captura % libre).
// requiereAprobacion decidido al configurarlo: si es true, la venta exige un autorizador
// con permiso venta.autorizar_descuento antes de confirmarse; si es false, se considera
// pre-aprobado por existir en el catálogo.
model Descuento {
  id                 String           @id @default(uuid())
  empresaId          String           @map("empresa_id")
  nombre             String
  tipo               TipoDescuento
  valor              Decimal // % (0-100) si tipo=PORCENTAJE, monto si tipo=MONTO_FIJO
  alcance            AlcanceDescuento @default(TODOS)
  categoriaId        String?          @map("categoria_id")
  articuloId         String?          @map("articulo_id")
  requiereAprobacion Boolean          @default(false) @map("requiere_aprobacion")
  activo             Boolean          @default(true)
  vigenciaDesde      DateTime?        @map("vigencia_desde")
  vigenciaHasta      DateTime?        @map("vigencia_hasta")
  creadoEn           DateTime         @default(now()) @map("creado_en")

  empresa     Empresa        @relation(fields: [empresaId], references: [id])
  categoria   Categoria?     @relation(fields: [categoriaId], references: [id])
  articulo    Articulo?      @relation(fields: [articuloId], references: [id])
  lineasVenta VentaDetalle[]

  @@map("descuentos")
}

// Promoción tipo "NxM" (ej. 2x1: cantidadRequerida=2, cantidadGratis=1). Mismo mecanismo
// de selección/aprobación que Descuento, pero acotada a un artículo o categoría (no TODOS,
// validado en el schema Zod, no tiene sentido un NxM sin un producto/categoría concreto).
model Promocion {
  id                 String           @id @default(uuid())
  empresaId          String           @map("empresa_id")
  nombre             String
  alcance            AlcanceDescuento
  categoriaId        String?          @map("categoria_id")
  articuloId         String?          @map("articulo_id")
  cantidadRequerida  Int              @map("cantidad_requerida")
  cantidadGratis     Int              @map("cantidad_gratis")
  requiereAprobacion Boolean          @default(false) @map("requiere_aprobacion")
  activo             Boolean          @default(true)
  vigenciaDesde      DateTime?        @map("vigencia_desde")
  vigenciaHasta      DateTime?        @map("vigencia_hasta")
  creadoEn           DateTime         @default(now()) @map("creado_en")

  empresa     Empresa        @relation(fields: [empresaId], references: [id])
  categoria   Categoria?     @relation(fields: [categoriaId], references: [id])
  articulo    Articulo?      @relation(fields: [articuloId], references: [id])
  lineasVenta VentaDetalle[]

  @@map("promociones")
}

// Relación secundaria proveedor-artículo (§15.5) — preparada, no bloqueante
model ArticuloProveedor {
  id          String  @id @default(uuid())
  articuloId  String  @map("articulo_id")
  proveedorId String  @map("proveedor_id")
  esPrincipal Boolean @default(false) @map("es_principal")

  articulo  Articulo  @relation(fields: [articuloId], references: [id])
  proveedor Proveedor @relation(fields: [proveedorId], references: [id])

  @@unique([articuloId, proveedorId])
  @@map("articulos_proveedores")
}

